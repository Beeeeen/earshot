{
  "name": "earshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An Alexa+ MCP add-on that treats the room as an untrusted channel.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:attack": "node --test --experimental-strip-types test/attack/*.test.ts",
    "test:latency": "node --test --experimental-strip-types test/latency/*.test.ts",
    "test:all": "node scripts/test-all.mjs",
    "selftest": "node dist/selftest/run.js",
    "demo": "npm run build && node dist/demo.js",
    "demo:serve": "npm run build && node dist/server.js --demo",
    "voice": "node scripts/make-voice.mjs",
    "assemble": "node scripts/assemble.mjs",
    "captions": "node scripts/make-captions.mjs",
    "thumbnail": "node scripts/make-thumbnail.mjs",
    "record": "node demo/tools/record.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}